APP_NAME=Gomez Ops
ENVIRONMENT=local
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PUBLISHER_MODE=mock

# Google Sheets integration
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_COMPLETED_JOBS_SHEET_NAME=Completed Jobs
GOOGLE_CONTENT_QUEUE_SHEET_NAME=Content Queue
GOOGLE_CAMPAIGNS_SHEET_NAME=Campaigns
GOOGLE_CAMPAIGN_CONTENT_QUEUE_SHEET_NAME=Campaign Content Queue
GOOGLE_POSTS_SHEET_NAME=Posts

# Google Business Profile publisher
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_BUSINESS_REDIRECT_URI=
GOOGLE_BUSINESS_API_BASE=https://mybusiness.googleapis.com/v4

# Meta Graph API publisher
# Use PUBLISHER_MODE=meta for real Graph API publishing.
# Use PUBLISHER_MODE=meta_export to generate Meta Business Suite packages without API calls.
META_GRAPH_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
PUBLIC_SITE_BASE_URL=
API_PUBLIC_BASE_URL=

# Supabase persistence foundation
# SUPABASE_SERVICE_ROLE_KEY is backend-only. Never expose it through frontend/Vite env vars.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Temporary until login/signup and JWT-based user identity are implemented.
# Must be a Supabase auth.users.id UUID that owns development business rows.
DEV_OWNER_USER_ID=
